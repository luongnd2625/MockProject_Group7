# Environment Variables Example (Khong commit .env that len Git - NFR-02/NFR-11)
APP_NAME="MockProject_Group7"
APP_ENV="development"
APP_TIMEZONE="Asia/Ho_Chi_Minh"
APP_CURRENCY="VND"

# Database (PostgreSQL)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/mockproject_group7_db"

# Security & Session (NFR-02, NFR-03)
SECRET_KEY="replace-with-strong-random-secret"
TOKEN_HASH_PEPPER="replace-with-random-pepper"
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PUBLIC_LOOKUP_MAX_FAILS=10
PUBLIC_LOOKUP_LOCK_MINUTES=15
PUBLIC_REQUEST_MAX_PER_10MIN=5

# Upload Guard (NFR-07)
UPLOAD_DIR="data/uploads"
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_EXTENSIONS="pdf,jpg,jpeg,png"

# Frontend CORS
FRONTEND_ORIGINS="http://localhost:5173"

# Phase 2: AI Agent (Chi su dung sau khi chot Phan 1 Software)
LLM_PROVIDER=""
LLM_MODEL=""
LLM_API_KEY=""
POLICY_DOCS_DIR="data/policies"
